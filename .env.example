# =============================================================================
# AgenticSQL — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- LLM Configuration ---
# Provider: openai | google_genai | anthropic | groq
# Note: For NVIDIA NIM (or other OpenAI compatible endpoints), use provider 'openai' 
# and set the LLM_BASE_URL.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your-api-key-here
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_TEMPERATURE=0.0

# --- Database Configuration ---
# Admin connection (used for seeding and DDL)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agenticsql

# Read-only connection (used for query execution)
DATABASE_URL_READONLY=postgresql+psycopg2://readonly_user:readonly_pass@localhost:5432/agenticsql

# --- Application Settings ---
MAX_RETRY_COUNT=3
MAX_RESULT_ROWS=1000
QUERY_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO

# --- FastAPI ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Streamlit ---
FRONTEND_PORT=8501
BACKEND_URL=http://localhost:8000
